<resources>

	<style name="AppTheme" parent="Theme.Bento">
		<item name="android:windowLightStatusBar">@bool/bento_light_bars</item>
		<item name="android:windowLightNavigationBar">@bool/bento_light_bars</item>
		<item name="android:popupMenuStyle">@style/Bento.PopupMenu</item>
		<item name="android:alertDialogTheme">@style/ThemeOverlay.Bento.Dialog</item>
		<item name="android:dialogTheme">@style/ThemeOverlay.Bento.Dialog</item>
		<item name="android:seekBarStyle">@style/AR.SeekBar</item>
		<item name="android:colorControlActivated">?attr/colorPrimary</item>
		<item name="android:colorAccent">?attr/colorPrimary</item>
	</style>
	<!-- Legacy colour-theme keys all map to the single Bento theme (system light/dark). -->
	<style name="AppTheme.Blue" parent="AppTheme" />
	<style name="AppTheme.Gray" parent="AppTheme" />
	<style name="AppTheme.Brown" parent="AppTheme" />
	<style name="AppTheme.DeepOrange" parent="AppTheme" />
	<style name="AppTheme.Pink" parent="AppTheme" />
	<style name="AppTheme.Purple" parent="AppTheme" />
	<style name="AppTheme.Red" parent="AppTheme" />
	<style name="AppTheme.Teal" parent="AppTheme" />
	<style name="AppTheme.Black" parent="AppTheme" />

	<style name="AR.SeekBar" parent="@android:style/Widget.Material.SeekBar">
		<item name="android:progressTint">?attr/colorPrimary</item>
		<item name="android:thumbTint">?attr/colorPrimary</item>
		<item name="android:progressBackgroundTint">?attr/colorOutline</item>
	</style>

	<style name="Button">
		<item name="android:textColor">@color/md_yellow_800F</item>
		<item name="android:textSize">@dimen/text_large</item>
	</style>

	<style name="Widget" parent="@android:style/Widget" />

	<style name="Widget.RaisedButton" parent="@android:style/Widget.Material.Button">
		<item name="android:textStyle">bold</item>
		<item name="android:textColor">@color/rec_accent</item>
		<item name="android:background">@android:color/transparent</item>
		<item name="android:fontFamily">@font/jakarta_bold</item>
		<item name="android:letterSpacing">0.025</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">@dimen/text_xmedium</item>
		<item name="android:paddingStart">@dimen/spacing_double</item>
		<item name="android:paddingEnd">@dimen/spacing_double</item>
		<item name="android:paddingTop">@dimen/spacing_medium</item>
		<item name="android:paddingBottom">@dimen/spacing_medium</item>
	</style>

	<style name="Widget.BorderlessButton" parent="@android:style/Widget.Material.Button.Borderless">
		<item name="android:textColor">#B3FFFFFF</item>
		<item name="android:letterSpacing">0.025</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:paddingStart">24dp</item>
		<item name="android:paddingEnd">24dp</item>
		<item name="android:paddingTop">@dimen/spacing_medium</item>
		<item name="android:paddingBottom">@dimen/spacing_medium</item>
		<item name="android:background">@drawable/button_translucent</item>
	</style>

	<style name="TextAppearance.DialogTitle" parent="@android:style/TextAppearance.Material.Title">
		<item name="android:textSize">22sp</item>
		<item name="android:gravity">start</item>
	</style>

	<style name="TextAppearance.DialogContent" parent="@android:style/TextAppearance.Material.Body1">
		<item name="android:textSize">16sp</item>
		<item name="android:textColor">?android:textColorSecondary</item>
		<item name="android:gravity">start</item>
	</style>

	<style name="Text">
		<item name="android:textColor">@color/text_primary_light</item>
		<item name="android:fontFamily">@font/jakarta_medium</item>
	</style>

	<style name="Text.NormalLabel" parent="Text">
		<item name="android:textSize">@dimen/text_large</item>
	</style>

	<style name="Text.SectionLabel">
		<item name="android:textColor">@color/text_primary_light</item>
		<item name="android:fontFamily">@font/jakarta_bold</item>
		<item name="android:letterSpacing">-0.02</item>
		<item name="android:textSize">24sp</item>
	</style>

	<style name="Widget.AudioRecorder.AppWidget.Container" parent="android:Widget">
		<item name="android:background">@drawable/app_widget_background</item>
	</style>

	<style name="Widget.AudioRecorder.AppWidget.InnerView" parent="android:Widget">
		<item name="android:background">@drawable/app_widget_inner_view_background</item>
	</style>

	<style name="Theme.Transparent" parent="android:Theme">
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowIsFloating">true</item>
		<item name="android:backgroundDimEnabled">false</item>
	</style>
</resources>
