<?xml version="1.0" encoding="utf-8"?>
<!-- Bento settings (2.0): square back button + big title, white grouped cards with pastel icon squares. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	tools:viewBindingIgnore="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="24dp">

		<LinearLayout
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingTop="12dp"
			android:paddingBottom="4dp">

			<ImageButton
				android:id="@+id/btnBack"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:background="@drawable/ar_square_btn"
				android:contentDescription="@null"
				android:scaleType="center"
				android:src="@drawable/ic_arrow_back" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="14dp"
				android:accessibilityHeading="true"
				android:text="@string/settings"
				android:textAppearance="@style/Bento.Text.Headline"
				android:textSize="26sp" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/migrate_public_storage_panel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:background="@drawable/ar_item_bg"
			android:backgroundTint="@color/bento_errorContainer"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="14dp"
			android:visibility="gone"
			tools:visibility="visible">

			<TextView
				android:id="@+id/txt_migrate_public_storage"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:drawableStart="@drawable/ic_warning_yellow"
				android:drawablePadding="12dp"
				android:text="@string/move_public_storage_records_message"
				android:textAppearance="@style/Bento.Text.Body"
				android:textColor="@color/bento_onErrorContainer" />

			<TextView
				android:id="@+id/btnView"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingStart="12dp"
				android:paddingTop="8dp"
				android:paddingEnd="4dp"
				android:paddingBottom="8dp"
				android:text="@string/view"
				android:textAppearance="@style/Bento.Text.TitleSmall"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:accessibilityHeading="true" android:text="@string/bento_section_library" android:textAppearance="@style/Bento.Text.Section" />
		<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ar_item_bg" android:clipToOutline="true" android:orientation="vertical">
			<LinearLayout android:id="@+id/btnTrash" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="16dp">
				<ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bento_icon_square" android:backgroundTint="@color/bento_tile_red_bg" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_delete" android:tint="@color/bento_tile_red_fg" />
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/trash" android:textAppearance="@style/Bento.Text.TileLabel" />
				<ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="?android:textColorTertiary" />
			</LinearLayout>
			<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="?attr/colorOutlineVariant" />
			<LinearLayout android:id="@+id/btn_file_browser" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="16dp">
				<ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bento_icon_square" android:backgroundTint="@color/bento_tile_blue_bg" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_folder_open" android:tint="@color/bento_tile_blue_fg" />
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/file_browser" android:textAppearance="@style/Bento.Text.TileLabel" />
				<ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="?android:textColorTertiary" />
			</LinearLayout>
		</LinearLayout>

		<Spinner
			android:id="@+id/themeColor"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:visibility="gone" />

		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:accessibilityHeading="true" android:text="@string/bento_section_recording" android:textAppearance="@style/Bento.Text.Section" />
		<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ar_item_bg" android:clipToOutline="true" android:orientation="vertical">
			<LinearLayout android:id="@+id/panelPublicDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
				<ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bento_icon_square" android:backgroundTint="@color/bento_tile_teal_bg" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_folder_open" android:tint="@color/bento_tile_teal_fg" />
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/store_records_public" android:textAppearance="@style/Bento.Text.TileLabel" />
				<Switch android:id="@+id/swPublicDir" android:layout_width="wrap_content" android:layout_height="wrap_content" />
			</LinearLayout>
			<TextView
				android:id="@+id/txt_records_location"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingStart="66dp"
				android:paddingEnd="16dp"
				android:paddingBottom="10dp"
				android:textAppearance="@style/Bento.Text.BodySmall"
				tools:text="@string/records_location" />
			<TextView
				android:id="@+id/txt_storage_info"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingStart="66dp"
				android:paddingEnd="16dp"
				android:paddingBottom="10dp"
				android:text="@string/feature_not_available_in_android_10"
				android:textAppearance="@style/Bento.Text.BodySmall"
				android:visibility="gone"
				tools:visibility="visible" />
			<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="?attr/colorOutlineVariant" />
			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
				<ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bento_icon_square" android:backgroundTint="@color/bento_tile_yellow_bg" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_lightbulb_on" android:tint="@color/bento_tile_yellow_fg" />
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/keep_screen_on" android:textAppearance="@style/Bento.Text.TileLabel" />
				<Switch android:id="@+id/swKeepScreenOn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
			</LinearLayout>
			<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="?attr/colorOutlineVariant" />
			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
				<ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bento_icon_square" android:backgroundTint="@color/bento_tile_violet_bg" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_pencil" android:tint="@color/bento_tile_violet_fg" />
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/ask_to_rename" android:textAppearance="@style/Bento.Text.TileLabel" />
				<Switch android:id="@+id/swAskToRename" android:layout_width="wrap_content" android:layout_height="wrap_content" />
			</LinearLayout>
			<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="66dp" android:background="?attr/colorOutlineVariant" />
			<Spinner
				android:id="@+id/name_format"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="56dp"
				android:paddingStart="0dp"
				android:paddingEnd="8dp" />
		</LinearLayout>

		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:accessibilityHeading="true" android:text="@string/bento_section_quality" android:textAppearance="@style/Bento.Text.Section" />
		<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ar_item_bg" android:clipToOutline="true" android:orientation="vertical">
			<LinearLayout
				android:id="@+id/info_panel"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="12dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:padding="12dp">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:id="@+id/txt_size_per_min"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textAppearance="@style/Bento.Text.TitleMedium"
						android:textColor="@color/bento_onPrimaryContainer"
						tools:text="5 Mb/min" />

					<TextView
						android:id="@+id/txt_information"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:textAppearance="@style/Bento.Text.BodySmall"
						android:textColor="@color/bento_onPrimaryContainer"
						tools:text="M4a/44100Hz/128kbps/Stereo" />
				</LinearLayout>

				<Button
					android:id="@+id/btnReset"
					style="@style/Widget.RaisedButton"
					android:layout_width="wrap_content"
					android:layout_height="40dp"
					android:paddingStart="16dp"
					android:paddingTop="0dp"
					android:paddingEnd="16dp"
					android:paddingBottom="0dp"
					android:text="@string/btn_reset"
					android:textColor="@color/white"
					android:textSize="14sp" />
			</LinearLayout>

			<com.dimowner.audiorecorder.app.widget.SettingView
				android:id="@+id/setting_recording_format"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

			<com.dimowner.audiorecorder.app.widget.SettingView
				android:id="@+id/setting_frequency"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

			<com.dimowner.audiorecorder.app.widget.SettingView
				android:id="@+id/setting_bitrate"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

			<com.dimowner.audiorecorder.app.widget.SettingView
				android:id="@+id/setting_channels"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="12dp" />
		</LinearLayout>

		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" android:accessibilityHeading="true" android:text="@string/bento_section_storage" android:textAppearance="@style/Bento.Text.Section" />
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/ar_item_bg"
			android:orientation="vertical"
			android:padding="16dp">

			<TextView
				android:id="@+id/txt_records_count"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="@style/Bento.Text.Body"
				tools:text="@string/total_record_count" />

			<TextView
				android:id="@+id/txt_total_duration"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:textAppearance="@style/Bento.Text.Body"
				tools:text="@string/total_duration" />

			<TextView
				android:id="@+id/txt_available_space"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:textAppearance="@style/Bento.Text.Body"
				tools:text="Available space: 34h:12m:22s" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
