<?xml version="1.0" encoding="utf-8"?>
<!-- Bento record row: white 20dp card, pastel icon square, name + info, duration, bookmark, more. -->
<FrameLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		xmlns:tools="http://schemas.android.com/tools"
		tools:viewBindingIgnore="true"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="16dp"
		android:paddingTop="4dp"
		android:paddingEnd="16dp"
		android:paddingBottom="4dp">

	<FrameLayout
			android:id="@+id/container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/ar_item_bg"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?android:attr/selectableItemBackground">

		<com.dimowner.audiorecorder.app.widget.SimpleWaveformView
				android:id="@+id/list_item_waveform"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginStart="72dp"
				android:layout_marginEnd="48dp"
				android:visibility="gone" />

		<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:minHeight="76dp"
				android:orientation="horizontal"
				android:paddingStart="14dp"
				android:paddingTop="10dp"
				android:paddingBottom="10dp">

			<ImageView
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:background="@drawable/bento_icon_square"
					android:backgroundTint="@color/bento_tile_red_bg"
					android:importantForAccessibility="no"
					android:padding="10dp"
					android:src="@drawable/ic_mic_bento"
					android:tint="@color/bento_tile_red_fg" />

			<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="14dp"
					android:layout_weight="1"
					android:orientation="vertical">

				<TextView
						android:id="@+id/list_item_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:ellipsize="end"
						android:maxLines="2"
						android:textAppearance="@style/Bento.Text.TitleMedium"
						android:textColor="?attr/colorOnSurface"
						tools:text="Record-1" />

				<FrameLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp">

					<TextView
							android:id="@+id/list_item_info"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:ellipsize="end"
							android:maxLines="1"
							android:textAppearance="@style/Bento.Text.BodySmall"
							tools:text="M4a, 44.1kHz, 128kbps" />

					<TextView
							android:id="@+id/list_item_date"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:maxLines="1"
							android:textAppearance="@style/Bento.Text.BodySmall"
							android:visibility="invisible" />
				</FrameLayout>
			</LinearLayout>

			<TextView
					android:id="@+id/list_item_description"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:background="@drawable/ar_chip_bg"
					android:maxLines="1"
					android:paddingStart="10dp"
					android:paddingTop="4dp"
					android:paddingEnd="10dp"
					android:paddingBottom="4dp"
					android:textAppearance="@style/Bento.Text.Label"
					android:textColor="?attr/colorOnSurfaceVariant"
					tools:text="00:25" />

			<ImageButton
					android:id="@+id/list_item_bookmark"
					android:layout_width="36dp"
					android:layout_height="40dp"
					android:background="?android:selectableItemBackgroundBorderless"
					android:contentDescription="@null"
					android:scaleType="center"
					android:src="@drawable/ic_bookmark_bordered_small" />

			<ImageButton
					android:id="@+id/list_item_more"
					android:layout_width="36dp"
					android:layout_height="40dp"
					android:layout_marginEnd="4dp"
					android:background="?android:selectableItemBackgroundBorderless"
					android:contentDescription="@null"
					android:scaleType="center"
					android:src="@drawable/ic_more_vert" />
		</LinearLayout>
	</FrameLayout>
</FrameLayout>
