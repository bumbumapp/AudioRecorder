<?xml version="1.0" encoding="utf-8"?>
<!-- Bento home (2.0): greeting header with square buttons, accent hero tile holding the
     waveform + timer, white tool tiles, big record control row, banner at the bottom. -->
<LinearLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		xmlns:tools="http://schemas.android.com/tools"
		tools:viewBindingIgnore="true"
		android:id="@+id/home_root"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="?attr/colorSurface"
		android:orientation="vertical"
		tools:context="com.dimowner.audiorecorder.app.main.MainActivity">

	<!-- Header -->
	<LinearLayout
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="bottom"
			android:orientation="horizontal"
			android:paddingStart="20dp"
			android:paddingTop="16dp"
			android:paddingEnd="20dp">

		<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

			<TextView
					android:id="@+id/txt_greeting"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textAppearance="@style/Bento.Text.Greeting"
					tools:text="Good morning" />

			<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:accessibilityHeading="true"
					android:text="@string/bento_home_title"
					android:textAppearance="@style/Bento.Text.Display" />
		</LinearLayout>

		<ImageButton
				android:id="@+id/btn_import"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="10dp"
				android:layout_marginBottom="2dp"
				android:background="@drawable/ar_square_btn"
				android:contentDescription="@string/bento_import"
				android:scaleType="center"
				android:src="@drawable/ic_import"
				android:stateListAnimator="@animator/bento_press" />

		<ImageButton
				android:id="@+id/btn_share"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="10dp"
				android:layout_marginBottom="2dp"
				android:background="@drawable/ar_square_btn"
				android:contentDescription="@string/bento_more"
				android:scaleType="center"
				android:src="@drawable/ic_more_vert"
				android:stateListAnimator="@animator/bento_press" />
	</LinearLayout>

	<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp">

		<LinearLayout
				android:id="@+id/pnl_import_progress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="horizontal"
				android:visibility="invisible"
				tools:visibility="visible">

			<ProgressBar
					style="?android:attr/progressBarStyleSmall"
					android:layout_width="16dp"
					android:layout_height="16dp" />

			<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:text="@string/import_progress"
					android:textAppearance="@style/Bento.Text.BodySmall" />
		</LinearLayout>

		<LinearLayout
				android:id="@+id/pnl_record_processing"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="horizontal"
				android:visibility="invisible">

			<ProgressBar
					style="?android:attr/progressBarStyleSmall"
					android:layout_width="16dp"
					android:layout_height="16dp" />

			<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:text="@string/record_processing"
					android:textAppearance="@style/Bento.Text.BodySmall" />
		</LinearLayout>
	</FrameLayout>

	<!-- Hero tile: live waveform, timer and record name -->
	<com.google.android.material.card.MaterialCardView
			style="@style/Bento.Hero"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginStart="20dp"
			android:layout_marginTop="4dp"
			android:layout_marginEnd="20dp"
			app:cardBackgroundColor="@color/bento_hero"
			app:cardCornerRadius="28dp">

		<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:paddingTop="20dp"
				android:paddingBottom="14dp">

			<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="20dp"
					android:paddingEnd="20dp">

				<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bento_hero_circle"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_mic_bento"
						app:tint="@color/ar_on_hero" />

				<TextView
						android:id="@+id/txt_record_info"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="10dp"
						android:layout_weight="1"
						android:ellipsize="end"
						android:maxLines="1"
						android:textAppearance="@style/Bento.Text.HeroSub"
						tools:text="M4a, 44.1kHz, 128kbps, Stereo" />
			</LinearLayout>

			<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1">

				<ImageView
						android:id="@+id/placeholder"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"
						android:importantForAccessibility="no"
						android:visibility="gone"
						app:tint="@color/ar_on_hero"
						tools:visibility="visible" />

				<com.dimowner.audiorecorder.app.widget.WaveformViewNew
						android:id="@+id/record"
						android:layout_width="match_parent"
						android:layout_height="@dimen/waveform_height"
						android:layout_gravity="center" />

				<com.dimowner.audiorecorder.app.widget.RecordingWaveformView
						android:id="@+id/recording_view"
						android:layout_width="match_parent"
						android:layout_height="@dimen/waveform_height"
						android:layout_gravity="center"
						android:visibility="gone" />

				<ProgressBar
						android:id="@+id/progress"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"
						android:indeterminateTint="@color/ar_on_hero"
						android:visibility="invisible" />
			</FrameLayout>

			<TextView
					android:id="@+id/txt_progress"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_horizontal"
					android:fontFamily="@font/jakarta_extrabold"
					android:letterSpacing="-0.02"
					android:textColor="@color/ar_on_hero"
					android:textSize="52sp"
					tools:text="00:00" />

			<TextView
					android:id="@+id/txt_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_horizontal"
					android:layout_marginStart="24dp"
					android:layout_marginEnd="24dp"
					android:drawableEnd="@drawable/ic_pencil_small"
					android:drawablePadding="6dp"
					android:drawableTint="@color/ar_on_hero"
					android:ellipsize="end"
					android:gravity="center_horizontal"
					android:maxLines="1"
					android:textAppearance="@style/Bento.Text.TitleMedium"
					android:textColor="@color/ar_on_hero"
					android:visibility="invisible"
					tools:text="Record-12"
					tools:visibility="visible" />

			<!-- Playback strip inside the hero -->
			<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">

				<FrameLayout
						android:layout_width="44dp"
						android:layout_height="44dp">

					<ImageButton
							android:id="@+id/btn_play"
							android:layout_width="44dp"
							android:layout_height="44dp"
							android:background="@drawable/bento_hero_circle"
							android:contentDescription="@string/bento_play"
							android:scaleType="center"
							android:src="@drawable/ic_play"
							android:visibility="invisible"
							app:tint="@color/ar_on_hero" />
				</FrameLayout>

				<SeekBar
						android:id="@+id/play_progress"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:max="1000"
						android:progressBackgroundTint="#66FFFFFF"
						android:progressTint="@color/ar_on_hero"
						android:thumbTint="@color/ar_on_hero" />

				<ImageButton
						android:id="@+id/btn_stop"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="@drawable/bento_hero_circle"
						android:contentDescription="@string/bento_stop"
						android:scaleType="center"
						android:src="@drawable/ic_stop"
						android:visibility="gone"
						app:tint="@color/ar_on_hero" />
			</LinearLayout>

			<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingStart="20dp"
					android:paddingEnd="20dp">

				<TextView
						android:id="@+id/txt_zero_time"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="start"
						android:text="@string/zero_time"
						android:textAppearance="@style/Bento.Text.HeroSub"
						android:visibility="invisible" />

				<TextView
						android:id="@+id/txt_duration"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="end"
						android:text="@string/zero_time"
						android:textAppearance="@style/Bento.Text.HeroSub"
						android:visibility="invisible" />
			</FrameLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Tool tiles -->
	<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="15dp"
			android:layout_marginTop="5dp"
			android:layout_marginEnd="15dp"
			android:orientation="horizontal">

		<com.google.android.material.card.MaterialCardView
				android:id="@+id/btn_records_list"
				style="@style/Bento.Tile"
				android:layout_width="0dp"
				android:layout_height="76dp"
				android:layout_margin="5dp"
				android:layout_weight="1"
				android:clickable="true"
				android:contentDescription="@string/records"
				android:focusable="true">

			<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="14dp"
					android:paddingEnd="12dp">

				<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:background="@drawable/bento_icon_square"
						android:backgroundTint="@color/bento_tile_red_bg"
						android:importantForAccessibility="no"
						android:padding="9dp"
						android:src="@drawable/ic_list"
						app:tint="@color/bento_tile_red_fg" />

				<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="@string/records"
						android:textAppearance="@style/Bento.Text.TileLabel" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.card.MaterialCardView
				android:id="@+id/btn_settings"
				style="@style/Bento.Tile"
				android:layout_width="0dp"
				android:layout_height="76dp"
				android:layout_margin="5dp"
				android:layout_weight="1"
				android:clickable="true"
				android:contentDescription="@string/settings"
				android:focusable="true">

			<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="14dp"
					android:paddingEnd="12dp">

				<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:background="@drawable/bento_icon_square"
						android:backgroundTint="@color/bento_tile_violet_bg"
						android:importantForAccessibility="no"
						android:padding="9dp"
						android:src="@drawable/ic_settings"
						app:tint="@color/bento_tile_violet_fg" />

				<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="@string/settings"
						android:textAppearance="@style/Bento.Text.TileLabel" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>

	<!-- Record controls -->
	<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:layout_marginBottom="8dp"
			android:gravity="center"
			android:orientation="horizontal">

		<ImageButton
				android:id="@+id/btn_record_delete"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:background="@drawable/ar_round_tile"
				android:contentDescription="@string/delete"
				android:scaleType="center"
				android:src="@drawable/ic_delete_forever"
				android:visibility="invisible" />

		<ImageButton
				android:id="@+id/btn_record"
				android:layout_width="96dp"
				android:layout_height="96dp"
				android:layout_marginStart="24dp"
				android:layout_marginEnd="24dp"
				android:background="?android:selectableItemBackgroundBorderless"
				android:contentDescription="@string/bento_record"
				android:scaleType="fitCenter"
				android:src="@drawable/btn_rec_idle"
				android:stateListAnimator="@animator/bento_press" />

		<ImageButton
				android:id="@+id/btn_record_stop"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:background="@drawable/ar_round_tile"
				android:contentDescription="@string/bento_stop"
				android:scaleType="center"
				android:src="@drawable/ic_stop"
				android:visibility="invisible" />
	</LinearLayout>

	<TextView
			android:id="@+id/btn_privacy_options"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:gravity="center"
			android:minHeight="32dp"
			android:padding="4dp"
			android:text="@string/privacy_options"
			android:textAppearance="@style/Bento.Text.BodySmall"
			android:visibility="gone" />

	<FrameLayout
			android:id="@+id/ad_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center" />
</LinearLayout>
